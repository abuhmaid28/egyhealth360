# Local development values only. Never use real credentials here.
POSTGRES_USER=egyhealth
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=egyhealth
# Host-run apps use the loopback-only compose.local.yaml database port.
DATABASE_URL=postgresql://egyhealth:local-development-only@localhost:5432/egyhealth
API_PORT=3001
NODE_ENV=development
AUTH_BROWSER_ORIGIN=http://localhost:3000
WORKER_POLL_MS=5000

# Explicit synthetic CLI bootstrap only; production rejected.
# Opt in privately with EH_DEMO_SEED_ENABLED=1.
# Inject EH_DEMO_PASSWORD privately; no example/default value is supplied.
# Optional loopback HTTP origin for m1:verify; defaults to API_PORT or 3001.
# M1_API_BASE_URL=http://127.0.0.1:3001

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  CLINICIAN
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum AssignmentStatus {
  ACTIVE
  ENDED

  @@map("assignment_status")
}

model User {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique(map: "users_email_key") @db.Text
  passwordHash     String            @map("password_hash") @db.Text
  role             UserRole
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile   PatientProfile?
  clinicianProfile ClinicianProfile?
  auditLogs        AuditLog[]
  sessions         Session[]
  createdCarePlans CarePlan[]

  @@unique([id, role], map: "users_id_role_key")
  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_user_fkey")

  @@index([userId, expiresAt], map: "sessions_user_expiry_idx")
  @@map("sessions")
}

model PatientProfile {
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                       @unique(map: "patient_profiles_user_id_key") @map("user_id") @db.Uuid
  userRole    UserRole                     @default(PATIENT) @map("user_role")
  displayName String                       @map("display_name") @db.Text
  dateOfBirth DateTime?                    @map("date_of_birth") @db.Date
  // Opaque optional profile text; no clinical/FHIR interpretation.
  sex         String?                      @db.Text
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                         @relation(fields: [userId, userRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict, map: "patient_profiles_user_role_fkey")
  assignments ClinicianPatientAssignment[]

  carePlans   CarePlan[]

  // Prisma requires the full composite relation key to be marked unique.
  @@unique([userId, userRole], map: "patient_profiles_user_role_key")
  @@map("patient_profiles")
}

model ClinicianProfile {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                       @unique(map: "clinician_profiles_user_id_key") @map("user_id") @db.Uuid
  userRole               UserRole                     @default(CLINICIAN) @map("user_role")
  displayName            String                       @map("display_name") @db.Text
  specialty              String?                      @db.Text
  professionalIdentifier String?                      @map("professional_identifier") @db.Text
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                         @relation(fields: [userId, userRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict, map: "clinician_profiles_user_role_fkey")
  assignments            ClinicianPatientAssignment[]

  @@unique([userId, userRole], map: "clinician_profiles_user_role_key")
  @@map("clinician_profiles")
}

model ClinicianPatientAssignment {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicianId String           @map("clinician_id") @db.Uuid
  patientId   String           @map("patient_id") @db.Uuid
  status      AssignmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt     DateTime?        @map("ended_at") @db.Timestamptz(3)
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_clinician_fkey")
  patient     PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_patient_fkey")

  // Active-pair partial uniqueness and history guards live in migration SQL.
  @@index([clinicianId, status, assignedAt], map: "assignments_clinician_history_idx")
  @@index([patientId, status, assignedAt], map: "assignments_patient_history_idx")
  @@map("clinician_patient_assignments")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actionType   String   @map("action_type") @db.Text
  entityType   String   @map("entity_type") @db.Text
  entityId     String   @map("entity_id") @db.Uuid
  timestamp    DateTime @default(now()) @db.Timestamptz(3)
  safeMetadata Json     @default("{}") @map("safe_metadata") @db.JsonB
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_actor_fkey")

  @@index([actorUserId, timestamp], map: "audit_logs_actor_timestamp_idx")
  @@index([entityType, entityId, timestamp], map: "audit_logs_entity_timestamp_idx")
  @@map("audit_logs")
}

enum ClinicalDefinitionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("clinical_definition_status")
}

model GuidelineSource {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKey           String   @unique(map: "guideline_sources_source_key_key") @map("source_key") @db.Text
  title               String   @db.Text
  publisher           String   @db.Text
  publicationIdentity String   @map("publication_identity") @db.Text
  publicationYear     Int      @map("publication_year")
  referenceIdentifier String?  @map("reference_identifier") @db.Text
  referenceUrl        String?  @map("reference_url") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  templates           CarePlanTemplate[]

  @@unique([publisher, title, publicationIdentity], map: "guideline_sources_publication_key")
  @@map("guideline_sources")
}

model CarePlanTemplate {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey       String                   @map("template_key") @db.Text
  name              String                   @db.Text
  conditionDomain   String                   @map("condition_domain") @db.Text
  version           String                   @db.Text
  guidelineSourceId String                   @map("guideline_source_id") @db.Uuid
  status            ClinicalDefinitionStatus @default(DRAFT)
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(3)
  retiredAt         DateTime?                 @map("retired_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)
  guidelineSource   GuidelineSource           @relation(fields: [guidelineSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plan_templates_source_fkey")
  rules             CareRuleDefinition[]
  carePlans         CarePlan[]

  @@unique([templateKey, version], map: "care_plan_templates_key_version_key")
  @@unique([name, version], map: "care_plan_templates_name_version_key")
  @@index([guidelineSourceId], map: "care_plan_templates_source_idx")
  @@map("care_plan_templates")
}

model CareRuleDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  ruleKey     String   @map("rule_key") @db.Text
  ruleVersion String   @map("rule_version") @db.Text
  actionType  String   @map("action_type") @db.Text
  definition  Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  template    CarePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_rule_definitions_template_fkey")

  carePlans   CarePlan[]

  @@unique([id, templateId], map: "care_rule_definitions_id_template_key")
  @@unique([templateId, ruleKey], map: "care_rule_definitions_template_rule_key")
  @@unique([ruleKey, ruleVersion], map: "care_rule_definitions_key_version_key")
  @@map("care_rule_definitions")
}


enum CarePlanStatus {
  DRAFT
  ACTIVE
  CANCELLED

  @@map("care_plan_status")
}

model CarePlan {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String @map("patient_id") @db.Uuid
  templateId       String @map("template_id") @db.Uuid
  ruleDefinitionId String @map("rule_definition_id") @db.Uuid
  createdByUserId  String @map("created_by_user_id") @db.Uuid
  status           CarePlanStatus @default(DRAFT)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_patient_fkey")
  template         CarePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_template_fkey")
  ruleDefinition   CareRuleDefinition @relation(fields: [ruleDefinitionId, templateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_rule_template_fkey")
  creator          User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_creator_fkey")

  @@index([patientId, createdAt], map: "care_plans_patient_history_idx")
  @@index([templateId], map: "care_plans_template_idx")
  @@index([ruleDefinitionId, templateId], map: "care_plans_rule_template_idx")
  @@index([createdByUserId], map: "care_plans_creator_idx")
  @@map("care_plans")
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  CLINICIAN
  ADMIN
  LAB_STAFF
  PHARMACY_STAFF

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum AssignmentStatus {
  ACTIVE
  ENDED

  @@map("assignment_status")
}

enum RelationshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  @@map("relationship_request_status")
}

model User {
  schedulingChanges ClinicSchedulingSettings[] @relation("SchedulingActor")
  availabilityPublications AvailabilitySlot[] @relation("AvailabilityPublisher")
  availabilityWithdrawals AvailabilitySlot[] @relation("AvailabilityWithdrawer")
  availabilityOperations AvailabilityOperation[]
  relationshipEnds AssignmentEndProvenance[]
  relationshipAcceptances RelationshipRequest[] @relation("RelationshipAcceptor")
  relationshipDeclines RelationshipRequest[] @relation("RelationshipDecliner")
  relationshipWithdrawals RelationshipRequest[] @relation("RelationshipWithdrawer")
  directorySpecialtyCreations Specialty[] @relation("SpecialtyCreator")
  directorySpecialtyChanges Specialty[] @relation("SpecialtyActor")
  directoryClinicDirectoryCreations ClinicDirectory[] @relation("ClinicDirectoryCreator")
  directoryClinicDirectoryChanges ClinicDirectory[] @relation("ClinicDirectoryActor")
  directoryClinicianDirectoryCreations ClinicianDirectory[] @relation("ClinicianDirectoryCreator")
  directoryClinicianDirectoryChanges ClinicianDirectory[] @relation("ClinicianDirectoryActor")
  directoryPublications DirectoryAffiliation[] @relation("DirectoryPublisher")
  directoryWithdrawals DirectoryAffiliation[] @relation("DirectoryWithdrawer")
  organizationCreations Organization[] @relation("OrganizationCreator")
  organizationStatusChanges Organization[] @relation("OrganizationStatusActor")
  organizationMemberships OrganizationMembership[] @relation("MembershipUser")
  membershipGrants OrganizationMembership[] @relation("MembershipGrantActor")
  membershipEnds OrganizationMembership[] @relation("MembershipEndActor")
  careActionSelections CareActionDecision[]

  bpAmendments BpAmendmentOperation[]
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String            @unique(map: "users_email_key") @db.Text
  passwordHash     String            @map("password_hash") @db.Text
  role             UserRole
  status           UserStatus        @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  patientProfile   PatientProfile?
  clinicianProfile ClinicianProfile?
  auditLogs        AuditLog[]
  sessions         Session[]
  createdCarePlans CarePlan[]
  recordedBloodPressureMeasurements BloodPressureMeasurement[]
  createdFollowUpAppointments FollowUpAppointment[] @relation("AppointmentCreator")
  cancelledFollowUpAppointments FollowUpAppointment[] @relation("AppointmentCanceller")
  recordedClinicalEncounters ClinicalEncounter[]
  recordedEncounterBloodPressureAssociations EncounterBloodPressureAssociation[]

  @@unique([id, role], map: "users_id_role_key")
  @@map("users")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "sessions_user_fkey")

  @@index([userId, expiresAt], map: "sessions_user_expiry_idx")
  @@map("sessions")
}

model PatientProfile {
  relationshipRequests RelationshipRequest[]
  @@unique([id,userId],map:"patient_profiles_id_user_key")
  bpAmendments BpAmendmentOperation[]
  bpExclusions BpExclusion[]
  bpPrivacyTargets BpPrivacyTarget[]
  id          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                       @unique(map: "patient_profiles_user_id_key") @map("user_id") @db.Uuid
  userRole    UserRole                     @default(PATIENT) @map("user_role")
  displayName String                       @map("display_name") @db.Text
  dateOfBirth DateTime?                    @map("date_of_birth") @db.Date
  // Opaque optional profile text; no clinical/FHIR interpretation.
  sex         String?                      @db.Text
  createdAt   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User                         @relation(fields: [userId, userRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict, map: "patient_profiles_user_role_fkey")
  assignments ClinicianPatientAssignment[]

  carePlans   CarePlan[]
  bloodPressureMeasurements BloodPressureMeasurement[]
  followUpAppointments FollowUpAppointment[]
  clinicalEncounters ClinicalEncounter[]
  encounterBloodPressureAssociations EncounterBloodPressureAssociation[]
  recordCoverageWindows RecordCoverageWindow[]
  observedApplicabilitySnapshots ObservedClinicalApplicabilitySnapshot[]

  // Prisma requires the full composite relation key to be marked unique.
  @@unique([userId, userRole], map: "patient_profiles_user_role_key")
  @@map("patient_profiles")
}

model ClinicianProfile {
  availabilitySlots AvailabilitySlot[]
  relationshipRequests RelationshipRequest[]
  directory ClinicianDirectory?
  @@unique([id,userId],map:"clinician_profiles_id_user_key")
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                       @unique(map: "clinician_profiles_user_id_key") @map("user_id") @db.Uuid
  userRole               UserRole                     @default(CLINICIAN) @map("user_role")
  displayName            String                       @map("display_name") @db.Text
  specialty              String?                      @db.Text
  professionalIdentifier String?                      @map("professional_identifier") @db.Text
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                   User                         @relation(fields: [userId, userRole], references: [id, role], onDelete: Restrict, onUpdate: Restrict, map: "clinician_profiles_user_role_fkey")
  assignments            ClinicianPatientAssignment[]

  @@unique([userId, userRole], map: "clinician_profiles_user_role_key")
  @@map("clinician_profiles")
}

model ClinicianPatientAssignment {
  relationshipRequests RelationshipRequest[] @relation("AcceptedAssignment")
  authorizationContexts RelationshipRequest[] @relation("AuthorizationAssignment")
  endProvenance AssignmentEndProvenance[]
  @@unique([id,clinicianId,patientId],map:"assignments_relationship_scope_key")
  careActionSelections CareActionDecision[]

  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clinicianId String           @map("clinician_id") @db.Uuid
  patientId   String           @map("patient_id") @db.Uuid
  status      AssignmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt     DateTime?        @map("ended_at") @db.Timestamptz(3)
  clinician   ClinicianProfile @relation(fields: [clinicianId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_clinician_fkey")
  patient     PatientProfile   @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "assignments_patient_fkey")

  // Active-pair partial uniqueness and history guards live in migration SQL.
  @@index([clinicianId, status, assignedAt], map: "assignments_clinician_history_idx")
  @@index([patientId, status, assignedAt], map: "assignments_patient_history_idx")
  @@map("clinician_patient_assignments")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actionType   String   @map("action_type") @db.Text
  entityType   String   @map("entity_type") @db.Text
  entityId     String   @map("entity_id") @db.Uuid
  timestamp    DateTime @default(now()) @db.Timestamptz(3)
  safeMetadata Json     @default("{}") @map("safe_metadata") @db.JsonB
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_logs_actor_fkey")

  @@index([actorUserId, timestamp], map: "audit_logs_actor_timestamp_idx")
  @@index([entityType, entityId, timestamp], map: "audit_logs_entity_timestamp_idx")
  @@map("audit_logs")
}

enum ClinicalDefinitionStatus {
  DRAFT
  PUBLISHED
  RETIRED

  @@map("clinical_definition_status")
}

model GuidelineSource {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceKey           String   @unique(map: "guideline_sources_source_key_key") @map("source_key") @db.Text
  title               String   @db.Text
  publisher           String   @db.Text
  publicationIdentity String   @map("publication_identity") @db.Text
  publicationYear     Int      @map("publication_year")
  referenceIdentifier String?  @map("reference_identifier") @db.Text
  referenceUrl        String?  @map("reference_url") @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  templates           CarePlanTemplate[]

  @@unique([publisher, title, publicationIdentity], map: "guideline_sources_publication_key")
  @@map("guideline_sources")
}

model CarePlanTemplate {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateKey       String                   @map("template_key") @db.Text
  name              String                   @db.Text
  conditionDomain   String                   @map("condition_domain") @db.Text
  version           String                   @db.Text
  guidelineSourceId String                   @map("guideline_source_id") @db.Uuid
  status            ClinicalDefinitionStatus @default(DRAFT)
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(3)
  retiredAt         DateTime?                 @map("retired_at") @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)
  guidelineSource   GuidelineSource           @relation(fields: [guidelineSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plan_templates_source_fkey")
  rules             CareRuleDefinition[]
  carePlans         CarePlan[]

  @@unique([templateKey, version], map: "care_plan_templates_key_version_key")
  @@unique([name, version], map: "care_plan_templates_name_version_key")
  @@index([guidelineSourceId], map: "care_plan_templates_source_idx")
  @@map("care_plan_templates")
}

model CareRuleDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String   @map("template_id") @db.Uuid
  ruleKey     String   @map("rule_key") @db.Text
  ruleVersion String   @map("rule_version") @db.Text
  actionType  String   @map("action_type") @db.Text
  definition  Json     @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)
  template    CarePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_rule_definitions_template_fkey")

  carePlans   CarePlan[]

  @@unique([id, templateId], map: "care_rule_definitions_id_template_key")
  @@unique([templateId, ruleKey], map: "care_rule_definitions_template_rule_key")
  @@unique([ruleKey, ruleVersion], map: "care_rule_definitions_key_version_key")
  @@map("care_rule_definitions")
}


enum CarePlanStatus {
  DRAFT
  ACTIVE
  CANCELLED

  @@map("care_plan_status")
}

model CarePlan {
  actions CareAction[] @relation("ActionPlan")
  actionDecisions CareActionDecision[] @relation("DecisionPlan")

  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId        String @map("patient_id") @db.Uuid
  templateId       String @map("template_id") @db.Uuid
  ruleDefinitionId String @map("rule_definition_id") @db.Uuid
  createdByUserId  String @map("created_by_user_id") @db.Uuid
  status           CarePlanStatus @default(DRAFT)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(3)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  patient          PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_patient_fkey")
  template         CarePlanTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_template_fkey")
  ruleDefinition   CareRuleDefinition @relation(fields: [ruleDefinitionId, templateId], references: [id, templateId], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_rule_template_fkey")
  creator          User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "care_plans_creator_fkey")

  @@index([patientId, createdAt], map: "care_plans_patient_history_idx")
  @@index([templateId], map: "care_plans_template_idx")
  @@index([ruleDefinitionId, templateId], map: "care_plans_rule_template_idx")
  @@index([createdByUserId], map: "care_plans_creator_idx")
  @@unique([id,patientId,templateId,ruleDefinitionId], map: "care_plans_action_scope_key")
  @@map("care_plans")
}


enum BloodPressureSourceKind {
  PATIENT_SELF_ENTRY
  CLINICIAN_ENTRY
  @@map("bp_measurement_source_kind")
}

model BloodPressureMeasurement {
  actionDecisions CareActionDecision[]

  amendmentTargets BpAmendmentOperation[] @relation("BpAmendmentTarget")
  duplicateReferences BpAmendmentOperation[] @relation("BpDuplicateReference")
  originAmendment BpAmendmentOperation? @relation("BpFreshEvidence")
  exclusion BpExclusion?
  privacyRestriction BpPrivacyTarget?
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  systolic Int
  diastolic Int
  unit String @db.Text
  measuredAt DateTime @map("measured_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  sourceKind BloodPressureSourceKind @map("source_kind")
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "blood_pressure_measurements_patient_fkey")
  recorder User @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "blood_pressure_measurements_actor_fkey")
  @@index([patientId, measuredAt(sort: Desc), id(sort: Desc)], map: "blood_pressure_measurements_patient_history_idx")
  @@index([recordedByUserId], map: "blood_pressure_measurements_actor_idx")
  encounterAssociation EncounterBloodPressureAssociation?
  @@unique([id, patientId], map: "blood_pressure_measurements_id_patient_key")
  @@map("blood_pressure_measurements")
}


enum FollowUpAppointmentStatus {
  SCHEDULED
  CANCELLED
  @@map("follow_up_appointment_status")
}

model FollowUpAppointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  purpose String @db.Text
  status FollowUpAppointmentStatus @default(SCHEDULED)
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId String? @map("cancelled_by_user_id") @db.Uuid
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follow_up_appointments_patient_fkey")
  creator User @relation("AppointmentCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follow_up_appointments_creator_fkey")
  canceller User? @relation("AppointmentCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follow_up_appointments_canceller_fkey")
  @@index([patientId, scheduledAt(sort: Desc), id(sort: Desc)], map: "follow_up_appointments_patient_history_idx")
  @@index([createdByUserId], map: "follow_up_appointments_creator_idx")
  @@index([cancelledByUserId], map: "follow_up_appointments_canceller_idx")
  @@map("follow_up_appointments")
}

model ClinicalEncounter {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  purpose String @db.Text
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clinical_encounters_patient_fkey")
  recorder User @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "clinical_encounters_recorder_fkey")
  bloodPressureAssociations EncounterBloodPressureAssociation[]
  @@unique([id, patientId], map: "clinical_encounters_id_patient_key")
  @@index([patientId, occurredAt(sort: Desc), id(sort: Desc)], map: "clinical_encounters_patient_history_idx")
  @@index([recordedByUserId], map: "clinical_encounters_recorder_idx")
  @@map("clinical_encounters")
}

model EncounterBloodPressureAssociation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  encounterId String @map("encounter_id") @db.Uuid
  bloodPressureMeasurementId String @unique(map: "encounter_bp_associations_measurement_key") @map("blood_pressure_measurement_id") @db.Uuid
  recordedByUserId String @map("recorded_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  patient PatientProfile @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "encounter_bp_associations_patient_fkey")
  encounter ClinicalEncounter @relation(fields: [encounterId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Restrict, map: "encounter_bp_associations_encounter_patient_fkey")
  measurement BloodPressureMeasurement @relation(fields: [bloodPressureMeasurementId, patientId], references: [id, patientId], onDelete: Restrict, onUpdate: Restrict, map: "encounter_bp_associations_measurement_patient_fkey")
  recorder User @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "encounter_bp_associations_recorder_fkey")
  @@index([patientId, encounterId, createdAt(sort: Desc), id(sort: Desc)], map: "encounter_bp_associations_patient_history_idx")
  @@index([encounterId, patientId], map: "encounter_bp_associations_encounter_idx")
  @@index([recordedByUserId], map: "encounter_bp_associations_recorder_idx")
  // Prisma requires the full composite defining relation key to be unique.
  @@unique([bloodPressureMeasurementId, patientId], map: "encounter_bp_associations_measurement_patient_key")
  @@map("encounter_bp_associations")
}

enum RecordCoverageSourceType {
  SYNTHETIC_BENCHMARK
  @@map("record_coverage_source_type")
}

enum RecordCoverageStatus {
  COMPLETE
  INCOMPLETE
  UNKNOWN
  @@map("record_coverage_status")
}

model RecordCoverageWindow {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId       String                   @map("patient_id") @db.Uuid
  sourceType      RecordCoverageSourceType @map("source_type")
  sourceReference String                   @map("source_reference") @db.Text
  coverageStatus  RecordCoverageStatus     @map("coverage_status")
  startAt         DateTime                 @map("start_at") @db.Timestamptz(6)
  endAt           DateTime                 @map("end_at") @db.Timestamptz(6)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  patient         PatientProfile           @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "record_coverage_windows_patient_fkey")

  @@unique([patientId, sourceType, sourceReference, coverageStatus, startAt, endAt], map: "record_coverage_windows_assertion_key")
  @@index([patientId, sourceType, sourceReference, startAt, endAt], map: "record_coverage_windows_partition_idx")
  @@map("record_coverage_windows")
}

enum ObservedApplicabilitySourceType {
  SYNTHETIC_OBSERVED_INPUT

  @@map("observed_applicability_source_type")
}

enum ObservedAgeAssertionState {
  NO_ASSERTION
  UNKNOWN
  ASSERTED_VALUE

  @@map("observed_age_assertion_state")
}

enum ObservedPregnancyStatus {
  PREGNANT
  NOT_PREGNANT
  UNKNOWN

  @@map("observed_pregnancy_status")
}

enum ObservedConditionStatus {
  PRESENT
  ABSENT
  UNKNOWN

  @@map("observed_condition_status")
}

model ObservedClinicalApplicabilitySnapshot {
  actionDecisions CareActionDecision[]
  actionMemberships CareActionApplicabilityInput[]

  id                   String                          @id(map: "oa_snapshots_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId            String                          @map("patient_id") @db.Uuid
  sourceType           ObservedApplicabilitySourceType @map("source_type")
  sourceReference      String                          @map("source_reference") @db.Text
  assertionReference   String                          @map("assertion_reference") @db.Text
  effectiveAt          DateTime                        @map("effective_at") @db.Timestamptz(6)
  assertedAt           DateTime                        @map("asserted_at") @db.Timestamptz(6)
  recordedAt           DateTime                        @default(now()) @map("recorded_at") @db.Timestamptz(3)
  ageAssertionState    ObservedAgeAssertionState       @map("age_assertion_state")
  ageYearsAtAssessment Int?                            @map("age_years_at_assessment")
  pregnancyStatus      ObservedPregnancyStatus?        @map("pregnancy_status")
  hypertensionStatus   ObservedConditionStatus?        @map("hypertension_status")
  cvdStatus            ObservedConditionStatus?        @map("cvd_status")
  diabetesStatus       ObservedConditionStatus?        @map("diabetes_status")
  ckdStatus            ObservedConditionStatus?        @map("ckd_status")

  patient              PatientProfile                  @relation(fields: [patientId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "oa_snapshots_patient_fkey")
  retraction           ObservedClinicalApplicabilityRetraction?

  @@unique([patientId, sourceType, sourceReference, assertionReference], map: "oa_snapshots_source_identity_key")
  @@unique([id, patientId, sourceType, sourceReference], map: "oa_snapshots_scope_key")
  @@index([patientId, effectiveAt, sourceType, sourceReference, assertionReference, id], map: "oa_snapshots_point_idx")
  @@unique([id,patientId], map: "oa_action_scope_key")
  @@map("observed_applicability_snapshots")
}

model ObservedClinicalApplicabilityRetraction {
  id                  String                                @id(map: "oa_retractions_pkey") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId          String                                @unique(map: "oa_retractions_target_key") @map("snapshot_id") @db.Uuid
  patientId           String                                @map("patient_id") @db.Uuid
  sourceType          ObservedApplicabilitySourceType       @map("source_type")
  sourceReference     String                                @map("source_reference") @db.Text
  retractionReference String                                @map("retraction_reference") @db.Text
  assertedAt          DateTime                              @map("asserted_at") @db.Timestamptz(6)
  recordedAt          DateTime                              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  reasonCode          String                                @map("reason_code") @db.Text

  snapshot            ObservedClinicalApplicabilitySnapshot @relation(fields: [snapshotId, patientId, sourceType, sourceReference], references: [id, patientId, sourceType, sourceReference], onDelete: Restrict, onUpdate: Restrict, map: "oa_retractions_snapshot_scope_fkey")

  @@unique([patientId, sourceType, sourceReference, retractionReference], map: "oa_retractions_source_identity_key")
  @@unique([snapshotId, patientId, sourceType, sourceReference], map: "oa_retractions_target_scope_key")
  @@map("observed_applicability_retractions")
}


// Issue #31: immutable operation identity, clinical exclusion and disclosure are distinct.
model BpAmendmentOperation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId String @map("patient_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  kind String @db.Text
  operationKey String @map("operation_key") @db.Uuid

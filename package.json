{
  "name": "egyhealth360",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "generate": "pnpm --filter @egyhealth/db generate",
    "build": "pnpm generate && pnpm -r build",
    "typecheck": "pnpm generate && pnpm -r --filter './packages/*' build && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.mjs",
    "test:migrations": "node --env-file-if-exists=.env scripts/verify-migrations.mjs",
    "dev": "pnpm build && node --env-file-if-exists=.env scripts/dev.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/demo-seed.mjs",
    "m1:verify": "node --env-file-if-exists=.env scripts/verify-m1.mjs",
    "m2:verify": "node --env-file-if-exists=.env scripts/verify-care-action-runtime.mjs",
    "clinical:bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-clinical-catalog.mjs",
    "test:ui": "node --test tests/ui-demo.test.mjs",
    "test:ui:browser": "bash -c 'set -euo pipefail; d=$(mktemp -d \"${TMPDIR:-/tmp}/eh-ui-browser.XXXXXX\"); cleanup() { rm -rf -- \"$d\"; }; trap cleanup EXIT; rc=0; bash scripts/test-ui-visual-recovery.sh HEAD \"$d\" || rc=$?; for f in install.log build.log browser.log; do if [ -s \"$d/$f\" ] && { [ \"$rc\" -ne 0 ] || [ \"$f\" = browser.log ]; }; then echo \"=== $f ===\"; cat \"$d/$f\"; fi; done; exit \"$rc\"'",
    "test:ui:real": "node scripts/test-ui-availability-real.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
